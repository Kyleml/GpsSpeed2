<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E1E"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvSpeed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0.0 km/h"
        android:textColor="#FFFFFF"
        android:textSize="60sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tvSignal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="信号强度: 等待..."
        android:textColor="#80FFFFFF"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="@id/tvSpeed"
        app:layout_constraintStart_toStartOf="@id/tvSpeed"
        app:layout_constraintTop_toBottomOf="@id/tvSpeed" />
     <!-- 新增：显示海拔高度 -->
    <TextView
        android:id="@+id/tvAltitude"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="海拔: -- m"
        android:textColor="#80FFFFFF"
        android:textSize="30sp"
        app:layout_constraintEnd_toEndOf="@id/tvSignal"
        app:layout_constraintStart_toStartOf="@id/tvSignal"
        app:layout_constraintTop_toBottomOf="@id/tvSignal" />

</androidx.constraintlayout.widget.ConstraintLayout>
